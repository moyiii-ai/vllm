#!/bin/bash
# Shared topology for dual-vLLM + shared Mooncake master (embedded segments).
#
# After A100 was added, nvidia-smi (CUDA_DEVICE_ORDER=PCI_BUS_ID) is:
#   GPU0 A100  30:00.0  NUMA0  PIX with NIC 2f:00.0   <- local vLLM
#   GPU1 L40S  41:00.0  NUMA0  (no PIX NIC; unused in a100-l40s)
#   GPU2 L40S  C3:00.0  NUMA1  PIX with NIC c1:00.0   <- remote vLLM
#
#   h1 / NIC 2f:00.0 / 10.1.1.1 / NUMA0 = local vLLM (:8000) + master/metadata
#   h2 / NIC c1:00.0 / 10.1.1.2 / NUMA1 = remote vLLM (:8001)
# RDMA *names* (mlx5_N) can renumber across boots; scripts resolve by PCI BDF.
#
# Each vLLM uses mode=embedded and contributes GLOBAL_SEGMENT_SIZE of local DRAM
# to the same Mooncake master (allowed; master coordinates multiple clients).

export CONDA_ENV="${CONDA_ENV:-vllm-0.22.1}"
export CONDA_SH="${CONDA_SH:-$HOME/miniconda3/etc/profile.d/conda.sh}"

# Stable CUDA index == nvidia-smi PCI_BUS_ID order (required: GPU2 must be NUMA1 L40S).
export CUDA_DEVICE_ORDER="${CUDA_DEVICE_ORDER:-PCI_BUS_ID}"
#
# GPU pair (local serve GPU + remote serve GPU):
#   a100-l40s  (default) — local GPU0 A100, remote GPU2 L40S
#   l40s-l40s            — local GPU1 L40S (NUMA0), remote GPU2 L40S
# Set BEFORE sourcing this file, or call apply_gpu_pair after changing GPU_PAIR:
#   GPU_PAIR=l40s-l40s ./start_all.sh
#   ./start_all.sh --l40s-l40s
export GPU_PAIR="${GPU_PAIR:-a100-l40s}"

apply_gpu_pair() {
  case "${GPU_PAIR}" in
    a100-l40s|a100)
      export GPU_PAIR=a100-l40s
      export LOCAL_GPU=0                  # A100 30:00.0
      export REMOTE_GPU=2                 # L40S C3:00.0
      export LOCAL_GPU_NAME=A100
      export REMOTE_GPU_NAME=L40S
      # A100 sits on switch 2b (no MPT SES) — pex-mon cannot see that path.
      export PEX_MON_DEVICE="${PEX_MON_DEVICE:-44:00.0}"
      export PEX_MON_PORTS="${PEX_MON_PORTS:-96,112,128}"
      export PEX_MON_PORT_MAPPING="${PEX_MON_PORT_MAPPING:-96:nic,112:gpu,128:cpu}"
      ;;
    l40s-l40s|l40s)
      export GPU_PAIR=l40s-l40s
      export LOCAL_GPU=1                  # L40S 41:00.0 (NUMA0, switch 3e)
      export REMOTE_GPU=2                 # L40S C3:00.0 (NUMA1)
      export LOCAL_GPU_NAME=L40S
      export REMOTE_GPU_NAME=L40S
      # SES 44:00.0 on switch 3e: 112=GPU1, 128=CPU uplink (96 unused / no NIC).
      export PEX_MON_DEVICE=44:00.0
      export PEX_MON_PORTS=96,112,128
      export PEX_MON_PORT_MAPPING=96:nic,112:gpu,128:cpu
      ;;
    *)
      echo "ERROR: unknown GPU_PAIR='$GPU_PAIR' (use a100-l40s or l40s-l40s)" >&2
      return 1
      ;;
  esac
}
apply_gpu_pair

export H1_NS=h1
export H2_NS=h2
export H1_IFACE=enp47s0np0   # netdev for NIC 2f:00.0 (NUMA0)
export H2_IFACE=enp193s0np0  # netdev for NIC c1:00.0 (NUMA1)
export H1_IP=10.1.1.1
export H2_IP=10.1.1.2
# Fixed Transfer-Engine listen ports so segment names are stable across restarts.
# Segment name = IP:TE_PORT (must match MOONCAKE_PREFERRED_SEGMENT for Put pin).
export H1_TE_PORT="${H1_TE_PORT:-19001}"
export H2_TE_PORT="${H2_TE_PORT:-19002}"
export H1_SEGMENT="${H1_SEGMENT:-${H1_IP}:${H1_TE_PORT}}"
export H2_SEGMENT="${H2_SEGMENT:-${H2_IP}:${H2_TE_PORT}}"
# Stable identity = PCI BDF. mlx5_* names are resolved at source time.
export H1_RDMA_BDF="${H1_RDMA_BDF:-0000:2f:00.0}"
export H2_RDMA_BDF="${H2_RDMA_BDF:-0000:c1:00.0}"
# Hints only (overwritten by resolve_rdma_names if BDF is present).
export H1_RDMA="${H1_RDMA:-mlx5_0}"
export H2_RDMA="${H2_RDMA:-mlx5_1}"
export MTU=9000

# veth: h1 internet/DNS (optional; intrahost test_mooncake/setup.sh). RDMA stays on 10.1.1.0/24.
export H1_VETH_NS="${H1_VETH_NS:-veth-h1}"
export H1_VETH_ROOT="${H1_VETH_ROOT:-veth-h1-root}"
export H1_VETH_NS_IP="${H1_VETH_NS_IP:-192.168.101.2}"
export H1_VETH_ROOT_IP="${H1_VETH_ROOT_IP:-192.168.101.1}"
export H1_VETH_SUBNET="${H1_VETH_SUBNET:-192.168.101.0/24}"
export HOST_UPLINK="${HOST_UPLINK:-enp3s0f0np0}"
export H1_DNS="${H1_DNS:-128.103.1.1 128.103.201.100 8.8.8.8}"

export MASTER_PORT=50051
export METADATA_PORT=8080
export VLLM_PORT_LOCAL="${VLLM_PORT_LOCAL:-8000}"
export VLLM_PORT_REMOTE="${VLLM_PORT_REMOTE:-8001}"

# FP8-dynamic weights (compressed-tensors); KV cache still BF16 unless
# --kv-cache-dtype is set. RedHatAI mirror is public (not gated).
export MODEL="${MODEL:-RedHatAI/Meta-Llama-3.1-8B-Instruct-FP8-dynamic}"
if [[ -z "${MODEL_LOCAL:-}" ]]; then
  _snap="${HOME}/.cache/huggingface/hub/models--RedHatAI--Meta-Llama-3.1-8B-Instruct-FP8-dynamic/snapshots"
  if [[ -d "$_snap" ]]; then
    # Require a real snapshot (tokenizer + weights), not a config-only stub
    # left by a partial hf_hub_download of config.json.
    for _cand in "$_snap"/*; do
      [[ -d "$_cand" ]] || continue
      if [[ -f "$_cand/config.json" && -f "$_cand/tokenizer.json" ]] && \
         compgen -G "$_cand/model*.safetensors" >/dev/null; then
        MODEL_LOCAL="$_cand"
        break
      fi
    done
  fi
fi
if [[ -n "${MODEL_LOCAL:-}" && -f "${MODEL_LOCAL}/config.json" ]]; then
  export MODEL="$MODEL_LOCAL"
fi
# First run downloads ~8GB; keep offline=0 until the snapshot exists.
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-0}"
export TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-0}"

export SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export LOG_DIR="${LOG_DIR:-$SCRIPT_DIR/logs}"

export DATASET_PATH="${DATASET_PATH:-$SCRIPT_DIR/../narrativeqa.jsonl}"
export DATASET_LOCAL="${DATASET_LOCAL:-$SCRIPT_DIR/narrativeqa_local.jsonl}"
export DATASET_REMOTE="${DATASET_REMOTE:-$SCRIPT_DIR/narrativeqa_remote.jsonl}"
# Round-robin L/R for measure (build with: python build_measure_roundrobin.py).
export DATASET_MEASURE="${DATASET_MEASURE:-$SCRIPT_DIR/narrativeqa_measure_rr.jsonl}"

# Per-vLLM embedded DRAM contribution (must be >0 in embedded mode).
# Two segments form ONE master pool. Full NarrativeQA unique KV ≈73GiB;
# 128GB/side fits all-KV-per-GPU with BatchPut headroom (64GB was own-half only).
export GLOBAL_SEGMENT_SIZE="${GLOBAL_SEGMENT_SIZE:-128GB}"
export LOCAL_BUFFER_SIZE="${LOCAL_BUFFER_SIZE:-1GB}"
export MAX_MODEL_LEN="${MAX_MODEL_LEN:-65536}"
# FlashAttn: MultipleOf(16); FlashInfer kernel list is [16,32,64].
# Probed in vllm-0.22.1 (Llama-3.1-8B, FLASH_ATTN): 32/64/128 all OK → use 128.
export BLOCK_SIZE="${BLOCK_SIZE:-128}"
# Mooncake: with protocol=rdma, LOCAL_MEMCPY is auto-disabled unless set.
# 1 = same-process DRAM↔GPU via memcpy/cudaMemcpy (not RNIC loopback GDR).
export MC_STORE_MEMCPY="${MC_STORE_MEMCPY:-1}"
# Put-time segment pin (ReplicateConfig.preferred_segment). Affects where
# warmup/save stores KV — not whether Get can read the other segment.
# Default ON; start_server.sh / start_all.sh --no-prefer-segment clears
# MOONCAKE_PREFERRED_SEGMENT (Mooncake then allocates freely across the pool).
# Restart + re-warmup after changing pins.
# MooncakeStoreConnector: pack all layers into one contiguous GPU segment
# per block (num_segments=1) instead of per-layer K/V scatter (e.g. 64).
# Larger cudaMemcpy chunks → higher local CPU→GPU PCIe goodput.
# Toggle requires restart + re-warmup (key/layout changes). 1/true/yes on.
export ENABLE_CROSS_LAYERS_BLOCKS="${ENABLE_CROSS_LAYERS_BLOCKS:-1}"
export GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.95}"
export OUT_LEN="${OUT_LEN:-16}"
export REQUEST_RATE="${REQUEST_RATE:-1}"

# Master / metadata live on CPU0 (NUMA0 / h1).
export MASTER_IP="${MASTER_IP:-$H1_IP}"
export MASTER_NS="${MASTER_NS:-$H1_NS}"
export MASTER_NUMA="${MASTER_NUMA:-0}"

export MOONCAKE_CONFIG_LOCAL="${MOONCAKE_CONFIG_LOCAL:-$SCRIPT_DIR/mooncake_config_local.json}"
export MOONCAKE_CONFIG_REMOTE="${MOONCAKE_CONFIG_REMOTE:-$SCRIPT_DIR/mooncake_config_remote.json}"
export MOONCAKE_CONFIG_PATH="${MOONCAKE_CONFIG_PATH:-$MOONCAKE_CONFIG_LOCAL}"

activate_conda() {
  # shellcheck disable=SC1090
  source "$CONDA_SH"
  conda activate "$CONDA_ENV"
}

# Parse --l40s-l40s / --a100-l40s from "$@"; echoes remaining args.
# Usage:  eval "set -- $(parse_gpu_pair_args "$@")"
parse_gpu_pair_args() {
  local out=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --l40s-l40s|l40s-l40s)
        export GPU_PAIR=l40s-l40s
        shift
        ;;
      --a100-l40s|a100-l40s)
        export GPU_PAIR=a100-l40s
        shift
        ;;
      *)
        out+=("$1")
        shift
        ;;
    esac
  done
  printf '%q ' "${out[@]+"${out[@]}"}"
}

# Normalize BDF to bare bb:dd.f (strip leading 0000:).
_norm_bdf() {
  local b="$1"
  b="${b#0000:}"
  echo "$b"
}

# Return current mlx5_* name for a PCI BDF, or fail.
rdma_name_for_bdf() {
  local want name bdf
  want="$(_norm_bdf "$1")"
  for dir in /sys/class/infiniband/mlx5_*; do
    [[ -e "$dir" ]] || continue
    name="$(basename "$dir")"
    bdf="$(_norm_bdf "$(basename "$(readlink -f "$dir/device")")")"
    if [[ "$bdf" == "$want" ]]; then
      echo "$name"
      return 0
    fi
  done
  return 1
}

# Resolve H1_RDMA / H2_RDMA from stable BDFs (fixes mlx5_* renumbering).
resolve_rdma_names() {
  local n
  if ! n="$(rdma_name_for_bdf "$H1_RDMA_BDF")"; then
    echo "ERROR: no RDMA device for H1 BDF $H1_RDMA_BDF (expected NUMA0 ConnectX)" >&2
    echo "  visible: $(ls /sys/class/infiniband 2>/dev/null | tr '\n' ' ')" >&2
    return 1
  fi
  if [[ "${H1_RDMA:-}" != "$n" ]]; then
    echo "NOTE: H1 RDMA name $H1_RDMA -> $n (BDF $H1_RDMA_BDF)"
  fi
  export H1_RDMA="$n"

  if ! n="$(rdma_name_for_bdf "$H2_RDMA_BDF")"; then
    echo "ERROR: no RDMA device for H2 BDF $H2_RDMA_BDF (expected NUMA1 ConnectX)" >&2
    echo "  visible: $(ls /sys/class/infiniband 2>/dev/null | tr '\n' ' ')" >&2
    return 1
  fi
  if [[ "${H2_RDMA:-}" != "$n" ]]; then
    echo "NOTE: H2 RDMA name $H2_RDMA -> $n (BDF $H2_RDMA_BDF)"
  fi
  export H2_RDMA="$n"
}

# Verify an RDMA name exists, matches expected BDF, and (optionally) is visible in a netns.
# Args: rdma_name expected_bdf [netns]
verify_rdma_device() {
  local name="$1" expect_bdf="$2" ns="${3:-}"
  local path actual
  expect_bdf="$(_norm_bdf "$expect_bdf")"
  path="/sys/class/infiniband/$name"
  if [[ ! -e "$path" ]]; then
    echo "ERROR: RDMA device '$name' not found under /sys/class/infiniband/" >&2
    echo "  hint: resolve_rdma_names maps BDF $expect_bdf; visible: $(ls /sys/class/infiniband 2>/dev/null | tr '\n' ' ')" >&2
    return 1
  fi
  actual="$(_norm_bdf "$(basename "$(readlink -f "$path/device")")")"
  if [[ "$actual" != "$expect_bdf" ]]; then
    echo "ERROR: $name is PCI $actual, expected $expect_bdf (stale mlx5_* name?)" >&2
    echo "  try: unset H1_RDMA H2_RDMA; source common.env  # re-resolve by BDF" >&2
    return 1
  fi
  if [[ -n "$ns" ]]; then
    if ! sudo ip netns exec "$ns" ibv_devinfo -d "$name" &>/dev/null; then
      echo "ERROR: RDMA '$name' (BDF $expect_bdf) not usable inside netns '$ns'" >&2
      echo "  devices in $ns:" >&2
      sudo ip netns exec "$ns" ibv_devices >&2 || true
      return 1
    fi
  fi
  echo "  RDMA ok: $name = $expect_bdf${ns:+ (netns $ns)}"
  return 0
}

# Warn if local GPU PCIe link is below Gen4 (L40S idle often drops to Gen1).
warn_if_local_gpu_pcie_slow() {
  local bdf speed
  case "${LOCAL_GPU}" in
    0) bdf=0000:30:00.0 ;;
    1) bdf=0000:41:00.0 ;;
    2) bdf=0000:c3:00.0 ;;
    *) return 0 ;;
  esac
  speed="$(cat /sys/bus/pci/devices/$bdf/current_link_speed 2>/dev/null || echo unknown)"
  echo "  local GPU$LOCAL_GPU ($LOCAL_GPU_NAME, $bdf) link: $speed x$(cat /sys/bus/pci/devices/$bdf/current_link_width 2>/dev/null || echo '?')"
  if [[ "$speed" == *"2.5"* || "$speed" == *"5.0"* ]]; then
    echo "WARNING: local GPU PCIe is $speed (want Gen4 16 GT/s). For L40S run:"
    echo "  sudo \$HOME/intrahost-app-workloads/setup_scripts/change-pcie-speed.sh 3e:02.0 gen4"
    echo "  sudo \$HOME/intrahost-app-workloads/setup_scripts/change-pcie-speed.sh 3c:01.0 gen4"
    echo "  (or re-run test_mooncake/setup.sh after updating PCIE_GEN4_PORTS)"
  fi
}

# Resolve mlx5_* from BDF now that helpers exist (soft: start_* scripts re-check).
if ! resolve_rdma_names; then
  echo "WARNING: RDMA BDF resolve failed at source time; start_server/start_all will re-check." >&2
fi

# Run as current user inside a netns (CUDA/HF home preserved).
netns_run() {
  local ns="$1"
  shift
  sudo ip netns exec "$ns" sudo -u "$USER" -E \
    env HOME="$HOME" USER="$USER" LOGNAME="$LOGNAME" \
        PATH="$PATH" LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}" \
        CUDA_HOME="${CUDA_HOME:-}" \
        HUGGING_FACE_HUB_TOKEN="${HUGGING_FACE_HUB_TOKEN:-}" \
        HF_TOKEN="${HF_TOKEN:-}" \
        HF_HOME="${HF_HOME:-}" \
        PYTHONHASHSEED=0 \
        "$@"
}

write_mooncake_config() {
  # Args: out_path device_name hostname
  local out="$1" device="$2" hostname="$3"
  python3 - <<PY
import json, os
master_ip = os.environ.get("MASTER_IP", os.environ["H1_IP"])
cfg = {
  "mode": "embedded",
  "metadata_server": f"http://{master_ip}:{os.environ['METADATA_PORT']}/metadata",
  "master_server_address": f"{master_ip}:{os.environ['MASTER_PORT']}",
  "global_segment_size": os.environ.get("GLOBAL_SEGMENT_SIZE", "128GB"),
  "local_buffer_size": os.environ.get("LOCAL_BUFFER_SIZE", "1GB"),
  "protocol": "rdma",
  "device_name": "$device",
  "enable_offload": False,
}
with open("$out", "w") as f:
    json.dump(cfg, f, indent=2)
    f.write("\n")
print("wrote", "$out", "-> master", cfg["master_server_address"])
PY
}

run_bench_on() {
  # Args: netns port dataset result_subdir [num_prompts]
  local ns="$1" port="$2" dataset="$3" subdir="$4"
  local nprompts="${5:-0}"
  local outdir="$LOG_DIR/$subdir"
  mkdir -p "$outdir"
  local n
  n="$(count_jsonl "$dataset")"
  if [[ "$nprompts" -le 0 ]]; then
    nprompts="$n"
  fi
  echo "=== bench ns=$ns port=$port prompts=$nprompts/$n dataset=$dataset ==="
  local BENCH
  BENCH="$(command -v vllm)"
  netns_run "$ns" stdbuf -oL -eL "$BENCH" bench serve \
    --backend vllm \
    --model "$MODEL" \
    --host 127.0.0.1 \
    --port "$port" \
    --dataset-name custom \
    --dataset-path "$dataset" \
    --custom-output-len "$OUT_LEN" \
    --num-prompts "$nprompts" \
    --request-rate "$REQUEST_RATE" \
    --ignore-eos \
    --save-result \
    --result-dir "$outdir"
}

count_jsonl() {
  local f="$1"
  if [[ ! -f "$f" ]]; then
    echo 0
    return
  fi
  grep -cve '^[[:space:]]*$' "$f" || true
}

# Append a warmup/measure phase boundary for report_server_stats.sh.
# Usage: phase_mark start|end warmup|measure
phase_mark() {
  local event="$1" phase="$2"
  mkdir -p "$LOG_DIR"
  python3 - "$LOG_DIR/phases.jsonl" "$event" "$phase" <<'PY'
import json, sys
from datetime import datetime
path, event, phase = sys.argv[1:4]
rec = {
    "event": event,
    "phase": phase,
    "ts": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
}
with open(path, "a", encoding="utf-8") as f:
    f.write(json.dumps(rec) + "\n")
print(f"phase_mark {event} {phase} @ {rec['ts']}")
PY
}

reset_phase_markers() {
  mkdir -p "$LOG_DIR"
  : >"$LOG_DIR/phases.jsonl"
}

wait_vllm_ready() {
  # Args: netns port log_file [tries] [sleep]
  local ns="$1" port="$2" logf="$3"
  local tries="${4:-120}" sleep_s="${5:-5}"
  local i code hint
  echo "Waiting for vLLM in $ns on :$port (up to $((tries * sleep_s))s) ..."
  for i in $(seq 1 "$tries"); do
    code="$(
      netns_run "$ns" curl -s -o /tmp/vllm_models_${port}.json -w '%{http_code}' \
        --max-time 2 "http://127.0.0.1:${port}/v1/models" 2>/dev/null || echo "000"
    )"
    if [[ "$code" == "200" ]]; then
      echo "[$i/$tries] HTTP $code — ready."
      return 0
    fi
    hint=""
    if [[ -f "$logf" ]]; then
      hint="$(rg -N 'Application startup complete|Uvicorn running|ERROR|OSError|Traceback|AddressNotRegistered' "$logf" 2>/dev/null | tail -1 || true)"
    fi
    if [[ -n "$hint" ]]; then
      echo "[$i/$tries] HTTP $code — not ready | ${hint:0:120}"
    else
      echo "[$i/$tries] HTTP $code — not ready"
    fi
    sleep "$sleep_s"
  done
  echo "Timeout. Tail of $logf:"
  tail -n 40 "$logf" 2>/dev/null || true
  return 1
}
