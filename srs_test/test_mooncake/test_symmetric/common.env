#!/bin/bash
# Shared topology for symmetric MultiConnector:
#   Both nodes: MultiConnector[
#     OffloadingConnector(kv_both),          # first: local H2D hits
#     MooncakeStoreConnector(kv_both),       # second: cross-NUMA GDR
#   ]
#   Both embedded into the same mooncake_master, Put pinned to own DRAM.
#
# Default GPU_PAIR=l40s-l40s (GPU1 + GPU2). Override with --a100-l40s.
#
# Datasets reuse parent test_mooncake split halves (local/remote/measure_rr).
#
# Topology:
#   GPU0 A100  30:00.0  NUMA0  PIX NIC 2f:00.0   <- unused in l40s-l40s
#   GPU1 L40S  41:00.0  NUMA0  (switch 3e)       <- local
#   GPU2 L40S  C3:00.0  NUMA1  PIX NIC c1:00.0   <- remote

export CONDA_ENV="${CONDA_ENV:-vllm-0.22.1}"
export CONDA_SH="${CONDA_SH:-$HOME/miniconda3/etc/profile.d/conda.sh}"

export CUDA_DEVICE_ORDER="${CUDA_DEVICE_ORDER:-PCI_BUS_ID}"
# Symmetric experiment default: two L40S (GPU1 + GPU2).
export GPU_PAIR="${GPU_PAIR:-l40s-l40s}"

apply_gpu_pair() {
  case "${GPU_PAIR}" in
    a100-l40s|a100)
      export GPU_PAIR=a100-l40s
      export LOCAL_GPU=0
      export REMOTE_GPU=2
      export LOCAL_GPU_NAME=A100
      export REMOTE_GPU_NAME=L40S
      export PEX_MON_DEVICE="${PEX_MON_DEVICE:-44:00.0}"
      export PEX_MON_PORTS="${PEX_MON_PORTS:-96,112,128}"
      export PEX_MON_PORT_MAPPING="${PEX_MON_PORT_MAPPING:-96:nic,112:gpu,128:cpu}"
      ;;
    l40s-l40s|l40s)
      export GPU_PAIR=l40s-l40s
      export LOCAL_GPU=1
      export REMOTE_GPU=2
      export LOCAL_GPU_NAME=L40S
      export REMOTE_GPU_NAME=L40S
      export PEX_MON_DEVICE=44:00.0
      export PEX_MON_PORTS=96,112,128
      export PEX_MON_PORT_MAPPING=96:nic,112:gpu,128:cpu
      ;;
    *)
      echo "ERROR: unknown GPU_PAIR='$GPU_PAIR' (use a100-l40s or l40s-l40s)" >&2
      return 1
      ;;
  esac
}
apply_gpu_pair

export H1_NS=h1
export H2_NS=h2
export H1_IFACE=enp47s0np0
export H2_IFACE=enp193s0np0
export H1_IP=10.1.1.1
export H2_IP=10.1.1.2
export H1_TE_PORT="${H1_TE_PORT:-19001}"
export H2_TE_PORT="${H2_TE_PORT:-19002}"
export H1_SEGMENT="${H1_SEGMENT:-${H1_IP}:${H1_TE_PORT}}"
export H2_SEGMENT="${H2_SEGMENT:-${H2_IP}:${H2_TE_PORT}}"
export H1_RDMA_BDF="${H1_RDMA_BDF:-0000:2f:00.0}"
export H2_RDMA_BDF="${H2_RDMA_BDF:-0000:c1:00.0}"
export H1_RDMA="${H1_RDMA:-mlx5_0}"
export H2_RDMA="${H2_RDMA:-mlx5_1}"
export MTU=9000

export H1_VETH_NS="${H1_VETH_NS:-veth-h1}"
export H1_VETH_ROOT="${H1_VETH_ROOT:-veth-h1-root}"
export H1_VETH_NS_IP="${H1_VETH_NS_IP:-192.168.101.2}"
export H1_VETH_ROOT_IP="${H1_VETH_ROOT_IP:-192.168.101.1}"
export H1_VETH_SUBNET="${H1_VETH_SUBNET:-192.168.101.0/24}"
export HOST_UPLINK="${HOST_UPLINK:-enp3s0f0np0}"
export H1_DNS="${H1_DNS:-128.103.1.1 128.103.201.100 8.8.8.8}"

export MASTER_PORT=50051
export METADATA_PORT=8080
export VLLM_PORT_LOCAL="${VLLM_PORT_LOCAL:-8000}"
export VLLM_PORT_REMOTE="${VLLM_PORT_REMOTE:-8001}"

export MODEL="${MODEL:-RedHatAI/Meta-Llama-3.1-8B-Instruct-FP8-dynamic}"
if [[ -z "${MODEL_LOCAL:-}" ]]; then
  _snap="${HOME}/.cache/huggingface/hub/models--RedHatAI--Meta-Llama-3.1-8B-Instruct-FP8-dynamic/snapshots"
  if [[ -d "$_snap" ]]; then
    for _cand in "$_snap"/*; do
      [[ -d "$_cand" ]] || continue
      if [[ -f "$_cand/config.json" && -f "$_cand/tokenizer.json" ]] && \
         compgen -G "$_cand/model*.safetensors" >/dev/null; then
        MODEL_LOCAL="$_cand"
        break
      fi
    done
  fi
fi
if [[ -n "${MODEL_LOCAL:-}" && -f "${MODEL_LOCAL}/config.json" ]]; then
  export MODEL="$MODEL_LOCAL"
fi
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-0}"
export TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-0}"

export SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export LOG_DIR="${LOG_DIR:-$SCRIPT_DIR/logs}"

# Reuse parent test_mooncake split / measure datasets (do not duplicate).
export MOONCAKE_TEST_DIR="${MOONCAKE_TEST_DIR:-$SCRIPT_DIR/..}"
export DATASET_PATH="${DATASET_PATH:-$SCRIPT_DIR/../../narrativeqa.jsonl}"
export DATASET_LOCAL="${DATASET_LOCAL:-$MOONCAKE_TEST_DIR/narrativeqa_local.jsonl}"
export DATASET_REMOTE="${DATASET_REMOTE:-$MOONCAKE_TEST_DIR/narrativeqa_remote.jsonl}"
export DATASET_MEASURE="${DATASET_MEASURE:-$MOONCAKE_TEST_DIR/narrativeqa_measure_rr.jsonl}"

# Each NUMA node is ~258 GiB. Warmup stores only the local half (~37 GiB unique KV)
# into BOTH Offloading and Mooncake, so 64 GiB + 64 GB leaves headroom for OS/vLLM.
# 128+128 would OOM. Override independently if needed.
export GLOBAL_SEGMENT_SIZE="${GLOBAL_SEGMENT_SIZE:-64GB}"
export LOCAL_BUFFER_SIZE="${LOCAL_BUFFER_SIZE:-1GB}"
export OFFLOADING_CPU_BYTES="${OFFLOADING_CPU_BYTES:-$((64 * 1024 * 1024 * 1024))}"
export OFFLOADING_BLOCK_SIZE="${OFFLOADING_BLOCK_SIZE:-128}"

export MAX_MODEL_LEN="${MAX_MODEL_LEN:-65536}"
export BLOCK_SIZE="${BLOCK_SIZE:-128}"
export MC_STORE_MEMCPY="${MC_STORE_MEMCPY:-1}"
export ENABLE_CROSS_LAYERS_BLOCKS="${ENABLE_CROSS_LAYERS_BLOCKS:-1}"
export GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.95}"
export OUT_LEN="${OUT_LEN:-16}"
export REQUEST_RATE="${REQUEST_RATE:-1}"

export MASTER_IP="${MASTER_IP:-$H1_IP}"
export MASTER_NS="${MASTER_NS:-$H1_NS}"
export MASTER_NUMA="${MASTER_NUMA:-0}"

export MOONCAKE_CONFIG_LOCAL="${MOONCAKE_CONFIG_LOCAL:-$SCRIPT_DIR/mooncake_config_local.json}"
export MOONCAKE_CONFIG_REMOTE="${MOONCAKE_CONFIG_REMOTE:-$SCRIPT_DIR/mooncake_config_remote.json}"
export MOONCAKE_CONFIG_PATH="${MOONCAKE_CONFIG_PATH:-$MOONCAKE_CONFIG_LOCAL}"

activate_conda() {
  # shellcheck disable=SC1090
  source "$CONDA_SH"
  conda activate "$CONDA_ENV"
}

parse_gpu_pair_args() {
  local out=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --l40s-l40s|l40s-l40s)
        export GPU_PAIR=l40s-l40s
        shift
        ;;
      --a100-l40s|a100-l40s)
        export GPU_PAIR=a100-l40s
        shift
        ;;
      *)
        out+=("$1")
        shift
        ;;
    esac
  done
  printf '%q ' "${out[@]+"${out[@]}"}"
}

_norm_bdf() {
  local b="$1"
  b="${b#0000:}"
  echo "$b"
}

rdma_name_for_bdf() {
  local want name bdf
  want="$(_norm_bdf "$1")"
  for dir in /sys/class/infiniband/mlx5_*; do
    [[ -e "$dir" ]] || continue
    name="$(basename "$dir")"
    bdf="$(_norm_bdf "$(basename "$(readlink -f "$dir/device")")")"
    if [[ "$bdf" == "$want" ]]; then
      echo "$name"
      return 0
    fi
  done
  return 1
}

resolve_rdma_names() {
  local n
  if ! n="$(rdma_name_for_bdf "$H1_RDMA_BDF")"; then
    echo "ERROR: no RDMA device for H1 BDF $H1_RDMA_BDF" >&2
    return 1
  fi
  if [[ "${H1_RDMA:-}" != "$n" ]]; then
    echo "NOTE: H1 RDMA name $H1_RDMA -> $n (BDF $H1_RDMA_BDF)"
  fi
  export H1_RDMA="$n"

  if ! n="$(rdma_name_for_bdf "$H2_RDMA_BDF")"; then
    echo "ERROR: no RDMA device for H2 BDF $H2_RDMA_BDF" >&2
    return 1
  fi
  if [[ "${H2_RDMA:-}" != "$n" ]]; then
    echo "NOTE: H2 RDMA name $H2_RDMA -> $n (BDF $H2_RDMA_BDF)"
  fi
  export H2_RDMA="$n"
}

verify_rdma_device() {
  local name="$1" expect_bdf="$2" ns="${3:-}"
  local path actual
  expect_bdf="$(_norm_bdf "$expect_bdf")"
  path="/sys/class/infiniband/$name"
  if [[ ! -e "$path" ]]; then
    echo "ERROR: RDMA device '$name' not found" >&2
    return 1
  fi
  actual="$(_norm_bdf "$(basename "$(readlink -f "$path/device")")")"
  if [[ "$actual" != "$expect_bdf" ]]; then
    echo "ERROR: $name is PCI $actual, expected $expect_bdf" >&2
    return 1
  fi
  if [[ -n "$ns" ]]; then
    if ! sudo ip netns exec "$ns" ibv_devinfo -d "$name" &>/dev/null; then
      echo "ERROR: RDMA '$name' not usable inside netns '$ns'" >&2
      return 1
    fi
  fi
  echo "  RDMA ok: $name = $expect_bdf${ns:+ (netns $ns)}"
  return 0
}

warn_if_gpu_pcie_slow() {
  local gpu="$1" name="$2"
  local bdf speed
  case "${gpu}" in
    0) bdf=0000:30:00.0 ;;
    1) bdf=0000:41:00.0 ;;
    2) bdf=0000:c3:00.0 ;;
    *) return 0 ;;
  esac
  speed="$(cat /sys/bus/pci/devices/$bdf/current_link_speed 2>/dev/null || echo unknown)"
  echo "  GPU$gpu ($name, $bdf) link: $speed x$(cat /sys/bus/pci/devices/$bdf/current_link_width 2>/dev/null || echo '?')"
  if [[ "$speed" == *"2.5"* || "$speed" == *"5.0"* ]]; then
    echo "WARNING: GPU$gpu PCIe is $speed (want Gen4 16 GT/s). For L40S GPU1 run:"
    echo "  sudo \$HOME/intrahost-app-workloads/test_mooncake/setup.sh"
  fi
}

warn_if_local_gpu_pcie_slow() {
  warn_if_gpu_pcie_slow "$LOCAL_GPU" "$LOCAL_GPU_NAME"
}

warn_if_remote_gpu_pcie_slow() {
  warn_if_gpu_pcie_slow "$REMOTE_GPU" "$REMOTE_GPU_NAME"
}

if ! resolve_rdma_names; then
  echo "WARNING: RDMA BDF resolve failed at source time; start_server/start_all will re-check." >&2
fi

netns_run() {
  local ns="$1"
  shift
  sudo ip netns exec "$ns" sudo -u "$USER" -E \
    env HOME="$HOME" USER="$USER" LOGNAME="$LOGNAME" \
        PATH="$PATH" LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}" \
        CUDA_HOME="${CUDA_HOME:-}" \
        HUGGING_FACE_HUB_TOKEN="${HUGGING_FACE_HUB_TOKEN:-}" \
        HF_TOKEN="${HF_TOKEN:-}" \
        HF_HOME="${HF_HOME:-}" \
        PYTHONHASHSEED=0 \
        "$@"
}

# Both roles: embedded Mooncake DRAM (same master). mlx5_* resolved by BDF.
write_mooncake_config() {
  # Args: out_path device_name
  local out="$1" device="$2"
  python3 - <<PY
import json, os
master_ip = os.environ.get("MASTER_IP", os.environ["H1_IP"])
cfg = {
  "mode": "embedded",
  "metadata_server": f"http://{master_ip}:{os.environ['METADATA_PORT']}/metadata",
  "master_server_address": f"{master_ip}:{os.environ['MASTER_PORT']}",
  "global_segment_size": os.environ.get("GLOBAL_SEGMENT_SIZE", "64GB"),
  "local_buffer_size": os.environ.get("LOCAL_BUFFER_SIZE", "1GB"),
  "protocol": "rdma",
  "device_name": "$device",
  "enable_offload": False,
}
with open("$out", "w") as f:
    json.dump(cfg, f, indent=2)
    f.write("\n")
print("wrote", "$out", "mode=embedded", "segment="+str(cfg["global_segment_size"]),
      "device="+cfg["device_name"], "master="+cfg["master_server_address"])
PY
}

# Identical MultiConnector on both roles: Offloading first, MooncakeStore second.
kv_transfer_config_json() {
  # Args: cross_layers_json(true|false)
  local cross="$1"
  python3 - <<PY
import json, os
cross = "$cross" == "true"
cfg = {
    "kv_connector": "MultiConnector",
    "kv_role": "kv_both",
    "kv_connector_extra_config": {
        "connectors": [
            {
                "kv_connector": "OffloadingConnector",
                "kv_role": "kv_both",
                "kv_connector_extra_config": {
                    "block_size": int(os.environ.get("OFFLOADING_BLOCK_SIZE", "128")),
                    "cpu_bytes_to_use": int(os.environ["OFFLOADING_CPU_BYTES"]),
                },
            },
            {
                "kv_connector": "MooncakeStoreConnector",
                "kv_role": "kv_both",
                "kv_connector_extra_config": {
                    "enable_cross_layers_blocks": cross,
                },
            },
        ]
    },
}
print(json.dumps(cfg, separators=(",", ":")))
PY
}

run_bench_on() {
  # Args: netns port dataset result_subdir [num_prompts]
  # Optional env: BENCH_EXTRA_BODY='{"kv_transfer_params":{"max_offload_tokens":0}}'
  local ns="$1" port="$2" dataset="$3" subdir="$4"
  local nprompts="${5:-0}"
  local outdir="$LOG_DIR/$subdir"
  mkdir -p "$outdir"
  local n
  n="$(count_jsonl "$dataset")"
  if [[ "$nprompts" -le 0 ]]; then
    nprompts="$n"
  fi
  echo "=== bench ns=$ns port=$port prompts=$nprompts/$n dataset=$dataset ==="
  if [[ -n "${BENCH_EXTRA_BODY:-}" ]]; then
    echo "  extra-body: $BENCH_EXTRA_BODY"
  fi
  local BENCH
  BENCH="$(command -v vllm)"
  local extra_args=()
  if [[ -n "${BENCH_EXTRA_BODY:-}" ]]; then
    extra_args+=(--extra-body "$BENCH_EXTRA_BODY")
  fi
  netns_run "$ns" stdbuf -oL -eL "$BENCH" bench serve \
    --backend vllm \
    --model "$MODEL" \
    --host 127.0.0.1 \
    --port "$port" \
    --dataset-name custom \
    --dataset-path "$dataset" \
    --custom-output-len "$OUT_LEN" \
    --num-prompts "$nprompts" \
    --request-rate "$REQUEST_RATE" \
    --ignore-eos \
    --save-result \
    --result-dir "$outdir" \
    "${extra_args[@]+"${extra_args[@]}"}"
}

count_jsonl() {
  local f="$1"
  if [[ ! -f "$f" ]]; then
    echo 0
    return
  fi
  grep -cve '^[[:space:]]*$' "$f" || true
}

phase_mark() {
  local event="$1" phase="$2"
  mkdir -p "$LOG_DIR"
  python3 - "$LOG_DIR/phases.jsonl" "$event" "$phase" <<'PY'
import json, sys
from datetime import datetime
path, event, phase = sys.argv[1:4]
rec = {
    "event": event,
    "phase": phase,
    "ts": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
}
with open(path, "a", encoding="utf-8") as f:
    f.write(json.dumps(rec) + "\n")
print(f"phase_mark {event} {phase} @ {rec['ts']}")
PY
}

reset_phase_markers() {
  mkdir -p "$LOG_DIR"
  : >"$LOG_DIR/phases.jsonl"
}

# --- smoke (single-request curl + KV-metrics wait) ---

smoke_write_body() {
  # Args: dataset line_idx out_body out_meta [extra_json]
  # extra_json is merged into the completions payload (e.g. kv_transfer_params).
  local dataset="$1" idx="$2" out_body="$3" out_meta="$4"
  local extra="${5:-}"
  python3 - "$dataset" "$idx" "$MODEL" "$OUT_LEN" "$out_body" "$out_meta" "$extra" <<'PY'
import json, sys
dataset, idx_s, model, max_tokens, out_body, out_meta, extra = sys.argv[1:8]
idx = int(idx_s)
prompt = None
with open(dataset, encoding="utf-8") as f:
    for i, line in enumerate(f, 1):
        if i == idx:
            obj = json.loads(line)
            prompt = obj["prompt"]
            break
if prompt is None:
    raise SystemExit(f"ERROR: line {idx} not found in {dataset}")
body = {
    "model": model,
    "prompt": prompt,
    "max_tokens": int(max_tokens),
    "temperature": 0,
    "ignore_eos": True,
}
if extra.strip():
    body.update(json.loads(extra))
with open(out_body, "w", encoding="utf-8") as f:
    json.dump(body, f)
with open(out_meta, "w", encoding="utf-8") as f:
    f.write(f"dataset={dataset}\n")
    f.write(f"line={idx}\n")
    f.write(f"prompt_chars={len(prompt)}\n")
    f.write(f"max_tokens={max_tokens}\n")
    if extra.strip():
        f.write(f"extra={extra}\n")
print(f"wrote {out_body} (prompt_chars={len(prompt)})")
PY
}

smoke_curl() {
  # Args: tag netns port body_json outdir
  local tag="$1" ns="$2" port="$3" body="$4" outdir="$5"
  local resp="$outdir/${tag}_resp.json"
  local http="$outdir/${tag}_http.txt"
  local timing="$outdir/${tag}_time.txt"
  netns_run "$ns" curl -sS \
    -X POST "http://127.0.0.1:${port}/v1/completions" \
    -H "Content-Type: application/json" \
    --data-binary @"$body" \
    -o "$resp" \
    -w "http_code=%{http_code}\ntime_total_s=%{time_total}\n" \
    >"$http" 2>"$outdir/${tag}_curl.err" || true
  cat "$http" >"$timing"
  local code secs
  code="$(sed -n 's/^http_code=//p' "$timing" | head -1)"
  secs="$(sed -n 's/^time_total_s=//p' "$timing" | head -1)"
  if [[ "$code" == "200" ]]; then
    echo "[$tag] OK http=$code time=${secs}s ns=$ns :$port -> $resp"
    return 0
  fi
  echo "[$tag] FAIL http=${code:-?} time=${secs:-?} (see $outdir/${tag}_*)"
  if [[ -s "$outdir/${tag}_curl.err" ]]; then
    sed -n '1,5p' "$outdir/${tag}_curl.err"
  fi
  if [[ -s "$resp" ]]; then
    python3 -c "import pathlib; t=pathlib.Path('$resp').read_text(errors='replace'); print(t[:400])"
  fi
  return 1
}

log_line_count() {
  local f="$1"
  if [[ -f "$f" ]]; then
    wc -l <"$f" | tr -d ' '
  else
    echo 0
  fi
}

wait_kv_transfer_metrics() {
  # Args: log_file after_line_count [timeout_s] [outfile]
  # Poll until a new "KV Transfer metrics:" line appears after after_line_count.
  # vLLM dumps these ~every 10s and then resets, so one isolated request maps
  # cleanly onto the next dump.
  local logf="$1" after="$2"
  local timeout_s="${3:-25}"
  local outfile="${4:-}"
  local t=0 line=""
  echo "Waiting up to ${timeout_s}s for KV Transfer metrics after line $after in $(basename "$logf") ..."
  while [[ "$t" -lt "$timeout_s" ]]; do
    if [[ -f "$logf" ]]; then
      line="$(awk -v n="$after" 'NR>n && /KV Transfer metrics:/ {print; exit}' "$logf")"
      if [[ -n "$line" ]]; then
        echo "$line"
        if [[ -n "$outfile" ]]; then
          printf '%s\n' "$line" >"$outfile"
        fi
        return 0
      fi
    fi
    sleep 1
    t=$((t + 1))
  done
  echo "WARNING: no new KV Transfer metrics line within ${timeout_s}s (log=$(basename "$logf"), after=$after)"
  return 1
}

summarize_kv_metrics() {
  # Args: metrics_line_file expected_kind
  # expected_kind: warmup_save | local_h2d | remote_gdr
  local infile="$1" kind="$2"
  python3 - "$infile" "$kind" <<'PY'
import ast, pathlib, re, sys
path, kind = sys.argv[1:3]
text = pathlib.Path(path).read_text(encoding="utf-8", errors="replace")
m = re.search(r"KV Transfer metrics:\s*(.*)$", text)
if not m:
    print("  (no KV Transfer metrics payload)")
    sys.exit(1)
blob = m.group(1).strip()
# Log is Python dict repr with connector names as bare identifiers.
blob = blob.replace("OffloadingConnector=", '"OffloadingConnector": ')
blob = blob.replace("MooncakeStoreConnector=", '"MooncakeStoreConnector": ')
if not blob.startswith("{"):
    blob = "{" + blob + "}"
try:
    data = ast.literal_eval(blob)
except Exception as e:
    print(f"  parse failed: {e}")
    print(f"  raw: {blob[:400]}")
    sys.exit(1)
off = data.get("OffloadingConnector") or {}
moon = data.get("MooncakeStoreConnector") or {}

def gb(x):
    return float(x or 0) / 1e9

cpu2gpu = off.get("CPU_to_GPU_total_bytes", 0) or 0
gpu2cpu = off.get("GPU_to_CPU_total_bytes", 0) or 0
load_b = moon.get("load_get_total_bytes", 0) or 0
load_n = moon.get("load_get_count", 0) or 0
put_b = moon.get("save_put_total_bytes", 0) or 0
put_n = moon.get("save_put_count", 0) or 0
exists_n = moon.get("save_exists_count", 0) or 0

print(f"  Offloading  CPU→GPU={gb(cpu2gpu):.3f} GB  GPU→CPU={gb(gpu2cpu):.3f} GB")
print(f"  Mooncake    load_get={gb(load_b):.3f} GB (n={load_n})  "
      f"save_put={gb(put_b):.3f} GB (n={put_n})  save_exists={exists_n}")

# 100 MB: ignore decode-sized Offloading stores vs GB-scale prompt KV.
small = 100 * 1024 * 1024
ok = True
notes = []
if kind == "warmup_save":
    if gpu2cpu <= 0 and put_b <= 0:
        ok = False
        notes.append("expected Offloading GPU→CPU and/or Mooncake save_put")
elif kind == "local_h2d":
    if cpu2gpu <= 0:
        ok = False
        notes.append("expected Offloading CPU→GPU (local DRAM hit)")
    if load_b > small:
        ok = False
        notes.append("did not expect Mooncake load_get on a local-half hit")
elif kind == "remote_gdr":
    if load_b <= 0:
        ok = False
        notes.append("expected Mooncake load_get (GDR from the other NUMA)")
    if gpu2cpu > small:
        ok = False
        notes.append("Offloading GPU→CPU is large — GDR KV was written back to CPU DRAM")
    if put_b > small:
        notes.append("Mooncake save_put is large — prefix may have been re-Put into local segment")
    if cpu2gpu > small:
        notes.append("Offloading CPU→GPU also fired (unexpected for a remote-half miss)")
else:
    notes.append(f"unknown kind={kind}")

status = "PASS" if ok else "FAIL"
print(f"  verdict: {status}" + ("" if not notes else " — " + "; ".join(notes)))
sys.exit(0 if ok else 1)
PY
}

wait_vllm_ready() {
  # Args: netns port log_file [tries] [sleep]
  local ns="$1" port="$2" logf="$3"
  local tries="${4:-120}" sleep_s="${5:-5}"
  local i code hint
  echo "Waiting for vLLM in $ns on :$port (up to $((tries * sleep_s))s) ..."
  for i in $(seq 1 "$tries"); do
    code="$(
      netns_run "$ns" curl -s -o /tmp/vllm_models_${port}.json -w '%{http_code}' \
        --max-time 2 "http://127.0.0.1:${port}/v1/models" 2>/dev/null || echo "000"
    )"
    if [[ "$code" == "200" ]]; then
      echo "[$i/$tries] HTTP $code — ready."
      return 0
    fi
    hint=""
    if [[ -f "$logf" ]]; then
      hint="$(grep -E 'Application startup complete|Uvicorn running|ERROR|OSError|Traceback|AddressNotRegistered' "$logf" 2>/dev/null | tail -1 || true)"
    fi
    if [[ -n "$hint" ]]; then
      echo "[$i/$tries] HTTP $code — not ready | ${hint:0:120}"
    else
      echo "[$i/$tries] HTTP $code — not ready"
    fi
    sleep "$sleep_s"
  done
  echo "Timeout. Tail of $logf:"
  tail -n 40 "$logf" 2>/dev/null || true
  return 1
}
